<header class="fixed inset-x-0 top-0 z-50">
  <div class="border-b border-border/60 bg-background/80 backdrop-blur-md page-x">
    <nav class="mx-auto flex h-16 max-w-[960px] items-center justify-between gap-3" aria-label="Global">
      <a href="/" class="inline-flex min-w-0 items-center gap-2.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label="Shellui for AI, home" translate="no">
        {% include "logo-mark.njk" %}
        <span class="truncate text-[15px] leading-none font-semibold tracking-tight text-foreground">Shellui <span class="text-primary-ink">for AI</span></span>
      </a>
      <div class="flex shrink-0 items-center gap-2 sm:gap-5">
        <a href="{{ site.docs }}" class="hidden text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Docs</a>
        <a href="{{ site.skills }}" class="hidden text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Skills</a>
        <a href="{{ site.website }}" class="inline-flex h-9 items-center gap-1.5 rounded-md px-3 text-sm font-semibold text-foreground ring-1 ring-border ring-inset transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"><span class="sm:hidden">Main site</span><span class="hidden sm:inline">Shellui main site</span><svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg></a>
        <button type="button" class="theme-toggle inline-flex size-11 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label="Toggle dark mode">
          <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
        </button>
      </div>
    </nav>
  </div>
</header>
